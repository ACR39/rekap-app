# Salin isi file ini ke pengaturan Secrets di Streamlit Community Cloud
# (App settings > Secrets). JANGAN commit file secrets.toml asli ke GitHub.

# Kata sandi untuk membuka aplikasi (opsional, hapus baris ini kalau tidak perlu)
password = "ganti-dengan-kata-sandi"

[github]
# Token dari GitHub: Settings > Developer settings > Fine-grained tokens.
# Beri akses hanya ke repositori data, izin "Contents: Read and write".
token = "github_pat_xxxxxxxxxxxxxxxx"
# Repositori PRIVAT khusus data, terpisah dari repositori kode aplikasi.
repo = "namaanda/rekap-data"
path = "data.json"
branch = "main"
